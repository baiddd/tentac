---
import Layout from "../layouts/Layout.astro";
import { getAllIssues } from "../lib/issues";

const issues = getAllIssues();
---
<Layout title="tentac — archive">
  <h1>Archive</h1>
  <ul>
    {issues.map((issue) => (
      <li>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/w/${issue.week}`}>{issue.week}</a> — {issue.headline}
      </li>
    ))}
  </ul>
  <p><a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/rss.xml`}>RSS feed &rarr;</a></p>
</Layout>
