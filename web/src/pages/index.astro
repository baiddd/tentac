---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import HeroSectionBlock from "../components/HeroSectionBlock.astro";
import { getAllIssues } from "../lib/issues";
import { getSectionPalette } from "../lib/coverPalette";
import "../styles/hero.css";

const issues = getAllIssues();
const latest = issues[0];

// The cover image is read directly off disk for color extraction only (see
// coverPalette.ts) — it's never displayed itself, the hero shows a plain
// black background with a color-matched decorative glow instead.
const palette = latest ? await getSectionPalette(latest.week) : {};
const defaultAccent = "#5ee6b0"; // matches --accent in global.css
const paletteColors = latest
  ? latest.sections.map((s) => palette[s.id as keyof typeof palette]).filter((c): c is string => Boolean(c))
  : [];
// Figma's cover uses three distinct colors (top glow, bottom fade, and the
// decorative light-gradiant blob) rather than one repeated accent. The
// bottom fade must match the first article's own color exactly, for a
// seamless transition into it; top and the glow use other palette entries
// for variety, falling back gracefully as the palette shrinks.
const heroBottomColor = paletteColors[0] || defaultAccent;
const heroTopColor = paletteColors[paletteColors.length - 1] || heroBottomColor;
const heroGlowColor = paletteColors[Math.floor(paletteColors.length / 2)] || heroBottomColor;

function weekLabel(week: string): string {
  return week.replace("-", " - ");
}
---
<Layout title={latest ? `tentac — ${latest.week}` : "tentac"} fullBleed={true}>
  {latest ? (
    <div class="hero-page">
      <Hero
        weekLabel={weekLabel(latest.week)}
        title={latest.title}
        headline={latest.headline}
        topColor={heroTopColor}
        bottomColor={heroBottomColor}
        glowColor={heroGlowColor}
      />
      <div class="hero-cover-divider" style={`background: linear-gradient(to bottom, #000, ${heroBottomColor})`} aria-hidden="true"></div>
      <div class="hero-sections">
        {latest.sections.map((section) => (
          <HeroSectionBlock section={section} color={palette[section.id as keyof typeof palette] || defaultAccent} />
        ))}
      </div>
      <footer class="hero-footer">
        <p class="hero-model-credit">Summary generated by {String(latest.stats?.analyzed_by ?? "Claude")}</p>
        {issues.length > 1 && (
          <div class="hero-week-picker">
            <label for="week-select">Jump to a week:</label>
            <select id="week-select">
              {issues.map((issue) => (
                <option value={issue.week} selected={issue.week === latest.week}>{issue.week}</option>
              ))}
            </select>
          </div>
        )}
        <p><a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/archive`}>See every past issue &rarr;</a></p>
      </footer>
    </div>
  ) : (
    <p class="no-issue">No issue published yet.</p>
  )}
  <script>
    // Scroll-linked effects for the hero, all driven from one
    // requestAnimationFrame-throttled scroll listener — the only client JS
    // this page adds beyond the site-wide glossary popover (Layout.astro):
    //   1. #hero-subtitle fades out over the first ~50px of scroll.
    //   2. #hero-logo scales down from hero size to the fixed "mini" size,
    //      and #hero-logo-backdrop fades in, over a zone ending at the
    //      bottom of the hero — see the mobile-hero-redesign Figma comments.
    //   3. #hero-week-label (moved next to the mini logo) fades in only
    //      after the logo has finished shrinking — a second, shorter zone
    //      that starts where the logo's own zone ends.
    (function () {
      const hero = document.querySelector(".hero");
      const logo = document.getElementById("hero-logo");
      const backdrop = document.getElementById("hero-logo-backdrop");
      const subtitle = document.getElementById("hero-subtitle");
      const weekLabel = document.getElementById("hero-week-label");
      if (!hero || !logo || !backdrop || !subtitle || !weekLabel) return;

      const LOGO_SCALE_MINI = 0.6824; // 27.294px mini size / 40px hero size — scaling DOWN stays crisp
      const TRANSITION_ZONE = 160; // px of scroll over which the logo shrinks
      const WEEK_LABEL_FADE_ZONE = 100; // px of scroll, right after the logo settles
      const SUBTITLE_FADE_DISTANCE = 50; // px of scroll for the subtitle fade

      let ticking = false;

      function update() {
        ticking = false;
        const scrollY = window.scrollY;
        const heroHeight = hero.getBoundingClientRect().height;

        const subtitleOpacity = Math.max(0, 1 - scrollY / SUBTITLE_FADE_DISTANCE);
        subtitle.style.setProperty("--subtitle-opacity", String(subtitleOpacity));

        const zoneStart = heroHeight - TRANSITION_ZONE;
        const progress = Math.min(1, Math.max(0, (scrollY - zoneStart) / TRANSITION_ZONE));
        const scale = 1 - progress * (1 - LOGO_SCALE_MINI);
        logo.style.setProperty("--logo-scale", String(scale));
        backdrop.style.setProperty("--backdrop-opacity", String(progress));

        const weekLabelZoneStart = zoneStart + TRANSITION_ZONE;
        const weekLabelOpacity = Math.min(1, Math.max(0, (scrollY - weekLabelZoneStart) / WEEK_LABEL_FADE_ZONE));
        weekLabel.style.setProperty("--week-label-opacity", String(weekLabelOpacity));

        // Positioned relative to the logo's actual current width rather
        // than a fixed offset — the logo's left position is fluid on
        // desktop (var(--content-pad) scales with viewport), so a hardcoded
        // left value on the label would drift out of sync and overlap it.
        const logoRect = logo.getBoundingClientRect();
        weekLabel.style.left = `${logoRect.right + 16}px`;
        weekLabel.style.top = `${logoRect.top + logoRect.height / 2}px`;
      }

      function onScroll() {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      update();
    })();
  </script>
  <script define:vars={{ base: import.meta.env.BASE_URL.replace(/\/$/, "") }}>
    const select = document.getElementById("week-select");
    if (select) {
      select.addEventListener("change", (event) => {
        const target = event.target;
        if (target && "value" in target) {
          window.location.href = `${base}/w/${target.value}`;
        }
      });
    }
  </script>
</Layout>
