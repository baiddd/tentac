---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import HeroSectionBlock from "../../components/HeroSectionBlock.astro";
import { getAllIssues, getIssue } from "../../lib/issues";
import { getGradientCoverPalette } from "../../lib/gradientCoverPalette";
import { getIssueCover } from "../../lib/gradient/issueCover";
import "../../styles/hero.css";

export function getStaticPaths() {
  return getAllIssues().map((issue) => ({ params: { week: issue.week } }));
}

const { week } = Astro.params;
const issue = getIssue(week!);
if (!issue) throw new Error(`no issue for week ${week}`);
const issues = getAllIssues();

// Same treatment as the homepage (see index.astro): this issue's cover
// (style+params) is resolved once and frozen in presets/issues/<week>.json
// (see gradient/issueCover.ts), so every entry point into it (home,
// "jump to a week", the archive) shows that exact same cover and matching
// section colors — and it never changes on a later rebuild.
const cover = getIssueCover(issue.week);
const palette = getGradientCoverPalette(cover.params);
const defaultAccent = "#5ee6b0"; // matches --accent in global.css

function weekLabel(week: string): string {
  return week.replace("-", " - ");
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: issue.headline,
  datePublished: issue.generated_at,
  dateModified: issue.generated_at,
  url: new URL(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/w/${issue.week}`, Astro.site).toString(),
  publisher: { "@type": "Organization", name: "tentac" },
  articleSection: issue.sections.map((s) => s.label),
};
---
<Layout title={`tentac — ${issue.week}`} fullBleed={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <div class="hero-page">
    <Hero
      weekLabel={weekLabel(issue.week)}
      title={issue.title}
      headline={issue.headline}
      coverStyleId={cover.styleId}
      coverParams={cover.params}
    />
    <div class="hero-sections">
      {issue.sections.map((section) => (
        <HeroSectionBlock section={section} color={palette[section.id as keyof typeof palette] || defaultAccent} />
      ))}
    </div>
    <footer class="hero-footer">
      <p class="hero-model-credit">Summary generated by {String(issue.stats?.analyzed_by ?? "Claude")}</p>
      {issues.length > 1 && (
        <div class="hero-week-picker">
          <label for="week-select">Jump to a week:</label>
          <select id="week-select">
            {issues.map((i) => (
              <option value={i.week} selected={i.week === issue.week}>{i.week}</option>
            ))}
          </select>
        </div>
      )}
      <p><a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/archive`}>See every past issue &rarr;</a></p>
    </footer>
  </div>
  <script>
    // Scroll-linked effects for the hero, all driven from one
    // requestAnimationFrame-throttled scroll listener — the only client JS
    // this page adds beyond the site-wide glossary popover (Layout.astro).
    // Mirrors index.astro's hero script exactly (see there for the
    // Figma-comment rationale behind each zone).
    (function () {
      const hero = document.querySelector(".hero");
      const logo = document.getElementById("hero-logo");
      const backdrop = document.getElementById("hero-logo-backdrop");
      const subtitle = document.getElementById("hero-subtitle");
      const sectionLabel = document.getElementById("hero-section-label");
      const sectionLabelLayers = Array.from(document.querySelectorAll(".hero-section-label-layer"));
      const bottomRow = document.getElementById("hero-bottom-row");
      const sections = Array.from(document.querySelectorAll(".hero-section"));
      if (!hero || !logo || !backdrop || !subtitle || !sectionLabel || sectionLabelLayers.length !== 2 || !bottomRow) return;

      const LOGO_SCALE_MINI = 0.6824; // 27.294px mini size / 40px hero size — scaling DOWN stays crisp
      const TRANSITION_ZONE = 160; // px of scroll over which the logo shrinks
      const SECTION_LABEL_FADE_ZONE = 100; // px of scroll, right after the logo settles
      const SUBTITLE_FADE_DISTANCE = 50; // px of scroll for the subtitle fade
      const BOTTOM_ROW_FADE_START = 280; // px from viewport top: still fully visible above this
      const BOTTOM_ROW_FADE_END = 150; // px from viewport top: fully faded by this (clears the header/backdrop zone)
      const ACTIVE_SECTION_LINE = 100; // px from viewport top: a section becomes "active" once its title crosses this

      let currentSectionTitle = "";
      let activeLayerIndex = 0;

      // True cross-fade between the two stacked layers: write the new
      // title into the currently-hidden layer, then swap which one is
      // .is-visible — both transition simultaneously (old fading out,
      // new fading in), rather than a sequential "vanish then reappear".
      function setActiveSectionTitle(title) {
        if (title === currentSectionTitle) return;
        currentSectionTitle = title;
        const nextIndex = 1 - activeLayerIndex;
        const nextLayer = sectionLabelLayers[nextIndex];
        const prevLayer = sectionLabelLayers[activeLayerIndex];
        nextLayer.textContent = title;
        nextLayer.classList.add("is-visible");
        prevLayer.classList.remove("is-visible");
        activeLayerIndex = nextIndex;
      }

      let ticking = false;

      function update() {
        ticking = false;
        const scrollY = window.scrollY;
        const heroHeight = hero.getBoundingClientRect().height;

        const subtitleOpacity = Math.max(0, 1 - scrollY / SUBTITLE_FADE_DISTANCE);
        subtitle.style.setProperty("--subtitle-opacity", String(subtitleOpacity));

        const zoneStart = heroHeight - TRANSITION_ZONE;
        const progress = Math.min(1, Math.max(0, (scrollY - zoneStart) / TRANSITION_ZONE));
        const scale = 1 - progress * (1 - LOGO_SCALE_MINI);
        logo.style.setProperty("--logo-scale", String(scale));
        backdrop.style.setProperty("--backdrop-opacity", String(progress));

        const sectionLabelZoneStart = zoneStart + TRANSITION_ZONE;
        const sectionLabelOpacity = Math.min(1, Math.max(0, (scrollY - sectionLabelZoneStart) / SECTION_LABEL_FADE_ZONE));
        sectionLabel.style.setProperty("--section-label-opacity", String(sectionLabelOpacity));

        // Bottom-aligned with the logo's own text (not vertically
        // centered) — tracks the logo's live box so it stays aligned
        // through the shrink transition; horizontal position is fixed in
        // CSS (right: var(--content-pad)), no JS needed for that axis.
        const logoRect = logo.getBoundingClientRect();
        sectionLabel.style.top = `${logoRect.bottom - sectionLabel.offsetHeight}px`;

        // The active section is the last one (in document order) whose
        // title has scrolled up to/past ACTIVE_SECTION_LINE — i.e. the
        // section currently being read just below the fixed header.
        let activeSection = null;
        for (const section of sections) {
          if (section.getBoundingClientRect().top <= ACTIVE_SECTION_LINE) {
            activeSection = section;
          }
        }
        setActiveSectionTitle(activeSection ? activeSection.dataset.sectionTitle || "" : "");

        const bottomRowBottom = bottomRow.getBoundingClientRect().bottom;
        const bottomRowOpacity = Math.min(
          1,
          Math.max(0, (bottomRowBottom - BOTTOM_ROW_FADE_END) / (BOTTOM_ROW_FADE_START - BOTTOM_ROW_FADE_END))
        );
        bottomRow.style.opacity = String(bottomRowOpacity);
      }

      function onScroll() {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      update();
    })();
  </script>
  <script define:vars={{ base: import.meta.env.BASE_URL.replace(/\/$/, "") }}>
    const select = document.getElementById("week-select");
    if (select) {
      select.addEventListener("change", (event) => {
        const target = event.target;
        if (target && "value" in target) {
          window.location.href = `${base}/w/${target.value}`;
        }
      });
    }
  </script>
</Layout>
