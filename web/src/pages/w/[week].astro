---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { getAllIssues, getIssue } from "../../lib/issues";
import { getCoverImage, getWeekTheme } from "../../lib/weekTheme";

export function getStaticPaths() {
  return getAllIssues().map((issue) => ({ params: { week: issue.week } }));
}

const { week } = Astro.params;
const issue = getIssue(week!);
if (!issue) throw new Error(`no issue for week ${week}`);
const issues = getAllIssues();
const cover = getCoverImage(issue.week);
const theme = getWeekTheme(issue.week);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: issue.headline,
  datePublished: issue.generated_at,
  dateModified: issue.generated_at,
  url: new URL(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/w/${issue.week}`, Astro.site).toString(),
  publisher: { "@type": "Organization", name: "tentac" },
  articleSection: issue.sections.map((s) => s.label),
};
---
<Layout title={`tentac — ${issue.week}`} theme={theme}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  {cover && <Image src={cover} alt={`Cover image for ${issue.week}`} class="cover-image" widths={[480, 960, 1440]} sizes="(min-width: 640px) 44rem, 100vw" />}
  <h1>tentac</h1>
  <p class="tagline">A weekly digest of what happened in AI — papers, lab releases, and security incidents, picked and summarized by Claude.</p>
  {issues.length > 1 && (
    <div class="week-picker">
      <label for="week-select">Jump to a week:</label>
      <select id="week-select">
        {issues.map((i) => (
          <option value={i.week} selected={i.week === issue.week}>{i.week}</option>
        ))}
      </select>
    </div>
  )}
  <p class="ai-summary">
    <span class="robot">🤖</span>{issue.headline}
    <small class="model-credit">Summary generated by {String(issue.stats?.analyzed_by ?? "Claude")}</small>
  </p>
  {issue.sections.map((section) => <SectionBlock section={section} />)}
  <p><a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/archive`}>See every past issue &rarr;</a></p>
  <script define:vars={{ base: import.meta.env.BASE_URL.replace(/\/$/, "") }}>
    const select = document.getElementById("week-select");
    if (select) {
      select.addEventListener("change", (event) => {
        const target = event.target;
        if (target && "value" in target) {
          window.location.href = `${base}/w/${target.value}`;
        }
      });
    }
  </script>
</Layout>
