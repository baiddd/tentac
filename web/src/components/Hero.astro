---
// The homepage cover — full-bleed black hero with a decorative radial glow
// (color-matched to the week's extracted palette), title, and headline.
// Pairs with the fixed/scaling "tentac" logo whose scroll behavior lives
// in index.astro's script (both halves of the same persistent-header
// interaction described in the Figma comments).

interface Props {
  weekLabel: string;
  /** Short punchy title (Issue.title) — the large bold line. Falls back to
   * `headline` when empty (issues published before this field existed). */
  title: string;
  /** Full descriptive sentence (Issue.headline) — shown as the smaller
   * paragraph under the title. */
  headline: string;
  /** Three distinct colors pulled from the extracted palette (top glow,
   * bottom fade, decorative light-gradiant blob) — matches Figma's cover,
   * which uses three different hand-picked colors rather than one repeated
   * accent. */
  topColor: string;
  bottomColor: string;
  glowColor: string;
}
const { weekLabel, title, headline, topColor, bottomColor, glowColor } = Astro.props;
const displayTitle = title || headline;
const displayDescription = title ? headline : "";
---
<div class="hero" style={`--hero-top-color: ${topColor}; --hero-bottom-color: ${bottomColor}; --hero-glow-color: ${glowColor}`}>
  <div class="hero-light-gradiant" aria-hidden="true"></div>
  <div class="hero-top-gradient" aria-hidden="true"></div>

  <div id="hero-logo-backdrop" class="hero-logo-backdrop" aria-hidden="true"></div>
  <p id="hero-logo" class="hero-logo">tentac</p>
  <!-- Moved here from the cover: stays fixed next to the mini logo once
       scrolled into the article, fading in only once the logo has finished
       shrinking to its mini size (see index.astro's scroll script). -->
  <p id="hero-week-label" class="hero-week-label">{weekLabel}</p>

  <div class="hero-content">
    <p id="hero-subtitle" class="hero-subtitle">A weekly digest of what happened in AI</p>

    <!-- Shares the exact same centered reading column as .hero-section-inner
         on desktop, so the title/description/badge line up with every other
         block of text on the page. The logo and subtitle above are
         deliberately excluded from this. -->
    <div class="hero-text-column">
      <div class="hero-badge">
        <span class="hero-badge-rule" aria-hidden="true"></span>
        <p class="hero-badge-text">Papers, lab releases, and security incidents, picked and summarized by Claude.</p>
        <span class="hero-badge-rule" aria-hidden="true"></span>
      </div>

      <p class="hero-title">{displayTitle}</p>
      {displayDescription && <p class="hero-description">{displayDescription}</p>}
    </div>
  </div>
</div>
